# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# GitHub — read-only PAT, used to pull PRs/issues/RFCs for the corpus
GITHUB_TOKEN=

# Anthropic — generation.py's LLM calls (Claude)
ANTHROPIC_API_KEY=

# Nebius (OpenAI-compatible) — not on the active path. EMBEDDING_MODEL
# currently defaults to a local sentence-transformers model (no key
# needed); set these + swap config.EMBEDDING_MODEL to move embeddings
# back to a Nebius-hosted model.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Graph store (skip both if using the NetworkX in-memory alternative)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
